-- Create the database
CREATE DATABASE "desserts-db";

-- Connect to the newly created database
\c "desserts-db";

-- Create the desserts table
CREATE TABLE desserts (
    id SERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    description TEXT
);

